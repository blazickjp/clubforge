---
import Layout from '../layouts/Layout.astro';
import adaptersData from '../../data/adapters.json';

const { adapters, compatibility_notes } = adaptersData;
---

<Layout title="Adapter Compatibility Guide | ClubForge">
  <main class="container mx-auto px-4 py-8 max-w-6xl">
    <h1 class="text-4xl font-bold text-center mb-4">🔧 Adapter Compatibility Guide</h1>
    <p class="text-center text-gray-400 mb-8 max-w-2xl mx-auto">
      Every driver head uses a proprietary adapter system. Understanding compatibility is key to building your perfect club.
    </p>

    <!-- Quick Tips -->
    <div class="bg-blue-900/30 border border-blue-500/50 rounded-lg p-6 mb-8">
      <h2 class="text-xl font-bold text-blue-400 mb-4">💡 What You Need to Know</h2>
      <ul class="space-y-2 text-gray-300">
        <li>✓ <strong>Universal Tip Size:</strong> {compatibility_notes.universal_tip}</li>
        <li>✓ <strong>Adapter Required:</strong> {compatibility_notes.adapter_requirement}</li>
        <li>✓ <strong>Cost:</strong> {compatibility_notes.adapter_cost}</li>
        <li>✓ <strong>Installation:</strong> {compatibility_notes.epoxy_tip}</li>
      </ul>
    </div>

    <!-- Adapter Grid -->
    <div class="grid md:grid-cols-2 gap-6 mb-8">
      {adapters.map((adapter) => (
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-green-500 transition-colors">
          <div class="flex justify-between items-start mb-3">
            <div>
              <h3 class="text-xl font-bold text-white">{adapter.name}</h3>
              <p class="text-green-400 font-medium">{adapter.brand}</p>
            </div>
            <span class="bg-green-600 text-white text-xs px-2 py-1 rounded">
              {adapter.tip_size}" tip
            </span>
          </div>
          
          <p class="text-gray-400 text-sm mb-4">{adapter.description}</p>
          
          <div class="grid grid-cols-2 gap-4 text-sm mb-4">
            <div>
              <span class="text-gray-500">Loft Adjust:</span>
              <span class="text-white ml-2">{adapter.loft_adjustment}</span>
            </div>
            <div>
              <span class="text-gray-500">Lie Adjust:</span>
              <span class="text-white ml-2">{adapter.lie_adjustment}</span>
            </div>
          </div>
          
          <div class="border-t border-gray-700 pt-3">
            <span class="text-gray-500 text-xs">Compatible Models:</span>
            <div class="flex flex-wrap gap-1 mt-1">
              {adapter.compatible_models.slice(0, 6).map((model) => (
                <span class="bg-gray-700 text-gray-300 text-xs px-2 py-0.5 rounded">
                  {model}
                </span>
              ))}
              {adapter.compatible_models.length > 6 && (
                <span class="text-gray-500 text-xs">+{adapter.compatible_models.length - 6} more</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Compatibility Matrix -->
    <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
      <h2 class="text-2xl font-bold mb-4">📊 Quick Reference</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-700">
              <th class="text-left py-2 px-3 text-gray-400">Brand</th>
              <th class="text-left py-2 px-3 text-gray-400">Adapter System</th>
              <th class="text-left py-2 px-3 text-gray-400">Loft Range</th>
              <th class="text-left py-2 px-3 text-gray-400">Lie Options</th>
            </tr>
          </thead>
          <tbody>
            {adapters.map((adapter) => (
              <tr class="border-b border-gray-700/50 hover:bg-gray-700/30">
                <td class="py-2 px-3 font-medium text-white">{adapter.brand}</td>
                <td class="py-2 px-3 text-green-400">{adapter.name}</td>
                <td class="py-2 px-3 text-gray-300">{adapter.loft_adjustment}</td>
                <td class="py-2 px-3 text-gray-300">{adapter.lie_adjustment}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-8">
      <p class="text-gray-400 mb-4">Ready to build your custom club?</p>
      <a href="/build" class="inline-block bg-green-600 hover:bg-green-500 text-white font-bold py-3 px-8 rounded-lg transition-colors">
        Start Building →
      </a>
    </div>
  </main>
</Layout>
